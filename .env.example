# Email Provider (Resend)
RESEND_API_KEY=
resend_API=

# OpenAI API Key (Backend AI Financial Planning Assistant)
OPENAI_API_KEY=

# API Server Port (Default: 5000)
PORT=5000

# Frontend Development Port (Default: 5173)
